{
  "$schema": "../../node_modules/ng-packagr/ng-package.schema.json",
  "dest": "../../dist/ngx-workshop-ui",
  "lib": {
    "entryFile": "src/public-api.ts"
  },
  "assets": [
    {
      "input": "src/styles",
      "glob": "**/*",
      "output": "styles"
    }
  ],
  "allowedNonPeerDependencies": [
    "@lezer/highlight",
    "@lezer/javascript",
    "@lezer/json",
    "@lezer/html",
    "@lezer/css"
  ]
}
