{
  "name": "ngx-workshop-design-system",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve storybook",
    "build": "ng build ngx-workshop-ui",
    "build:demo": "ng build storybook",
    "storybook": "ng run storybook:storybook",
    "build-storybook": "ng run storybook:build-storybook",
    "typecheck:stories": "tsc --project projects/storybook/tsconfig.stories.json --noEmit",
    "test": "playwright test",
    "verify": "npm run build && npm run build:demo && npm run typecheck:stories && npm run build-storybook && npm run verify:package",
    "verify:package": "node scripts/verify-package.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "private": true,
  "packageManager": "npm@11.6.0",
  "dependencies": {
    "@angular/animations": "21.1.0",
    "@angular/cdk": "21.1.0",
    "@angular/common": "21.1.0",
    "@angular/compiler": "21.1.0",
    "@angular/core": "21.1.0",
    "@angular/forms": "21.1.0",
    "@angular/material": "21.1.0",
    "@angular/platform-browser": "21.1.0",
    "@angular/platform-browser-dynamic": "21.1.0",
    "@angular/router": "21.1.0",
    "@lezer/css": "1.3.9",
    "@lezer/highlight": "1.2.5",
    "@lezer/html": "1.3.13",
    "@lezer/javascript": "1.5.6",
    "@lezer/json": "1.0.3",
    "rxjs": "7.8.2",
    "tslib": "2.8.1",
    "zone.js": "0.16.0"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "21.1.0",
    "@angular-devkit/core": "21.1.0",
    "@angular/build": "21.1.0",
    "@angular/cli": "21.1.0",
    "@angular/compiler-cli": "21.1.0",
    "@codemirror/lang-javascript": "6.2.5",
    "@codemirror/language": "6.13.1",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.15",
    "@fsegurai/codemirror-theme-synthwave-84": "6.0.4",
    "@playwright/test": "1.56.1",
    "@storybook/addon-a11y": "10.6.3",
    "@storybook/addon-docs": "10.6.3",
    "@storybook/angular": "10.6.3",
    "axe-core": "4.14.0",
    "codemirror": "6.0.2",
    "ng-packagr": "21.1.0",
    "prettier": "3.6.2",
    "storybook": "10.6.3",
    "typescript": "5.9.3"
  },
  "type": "module",
  "engines": {
    "node": ">=22.12.0 <23 || >=24.0.0 <25"
  },
  "overrides": {
    "webpack": "5.105.2"
  }
}
